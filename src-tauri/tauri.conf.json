{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZDocs",
  "version": "0.1.8",
  "identifier": "com.zdocs.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ZDocs", "width": 1380, "height": 860, "minWidth": 980, "minHeight": 640, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "signingIdentity": "-" }
  }
}
